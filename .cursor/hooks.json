{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/aps-before-submit.mjs",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/aps-pre-tool-use.mjs",
        "matcher": "Write|StrReplace|EditNotebook",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/aps-stop.mjs",
        "timeout": 360
      }
    ]
  }
}
