# Neon PostgreSQL
DATABASE_URL=

# Auth.js — AUTH_URL should match SITE_ORIGIN unless documented exception
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (Start Free Trial / Create Plan when DEV_AUTH_BYPASS is off)
# Production: add authorized redirect URIs in Google Cloud Console for each
# deploy origin (e.g. https://your-domain/api/auth/callback/google).
# Local redirect_uri_mismatch is an OAuth console config issue — do not "fix"
# it by enabling DEV_AUTH_BYPASS in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development only: skip Google on Create Plan and bootstrap the Zynava workspace.
# Ignored when NODE_ENV=production. In non-production, default is ON unless set to false.
# Set DEV_AUTH_BYPASS=false only when you intentionally want to test Google OAuth locally.
# Never use NEXT_PUBLIC_*. Legacy AUTH_BYPASS=true is also honored.
DEV_AUTH_BYPASS=true

# Content Production Studio — Prompt Inspector (server-only; never NEXT_PUBLIC_).
# Development default: enabled. Set false to hide. Production: only with =true.
# CONTENT_PROMPT_INSPECTOR=true
# CONTENT_PROMPT_INSPECTOR=false

# OpenAI (Brand Profile + strategy)
OPENAI_API_KEY=
# Discovery LLM only (Brand Profile + strategy). Default: gpt-5.4-nano.
# Override locally for cost A/B (e.g. gpt-5-nano). Server-only — never NEXT_PUBLIC_.
# Does not affect llm-atom, project-knowledge ask, or intelligent-v1.
OPENAI_DISCOVERY_MODEL=gpt-5.4-nano
# Display-copy polish (card row title + summary only). On when OPENAI_API_KEY is set.
# Fail-closed to deterministic copy. Set deterministic-only or off to skip.
# Leave DISCOVERY_COPY_POLISH_PROVIDER empty for default-on behavior.
DISCOVERY_COPY_POLISH_PROVIDER=
OPENAI_DISCOVERY_POLISH_MODEL=gpt-5.4-nano


# Topic title hooks (Hooked Trigger on candidate titles after educational frame).
# Default: deterministic-v1 templates. Set off to skip rewrite (keep framed titles).
# TOPIC_TITLE_HOOK_PROVIDER=deterministic-v1
# TOPIC_TITLE_HOOK_PROVIDER=off
# OPENAI_TOPIC_TITLE_HOOK_MODEL=gpt-5-nano

# Topic candidate generation model. Default gpt-5.4-nano (16s, fills six slots);
# gpt-5-nano works but measured 76s and filled five. Leave unset to use the
# registry default (gpt-5.4-nano); only set to override for cost A/B.
# OPENAI_TOPIC_CANDIDATES_MODEL=gpt-5.4-nano

# Hook enrichment after deterministic six directions (Hooked Variable Reward on punchlines).
# HOOK_ENRICHMENT_PROVIDER=openai enables OpenAI polish; default is deterministic passthrough.
# OPENAI_HOOK_ENRICHMENT_MODEL=gpt-5-nano
# HOOK_ENRICHMENT_PROVIDER=deterministic-v1

# Opt-in intelligent directions provider model (default gpt-5-nano).
# OPENAI_DIRECTIONS_MODEL=gpt-5-nano

# Content Atom LLM path (preferLlm experiments). Registry default: gpt-5.4-nano.
# Falls back to OPENAI_DISCOVERY_MODEL when unset. Leave unset for the default.
# OPENAI_CONTENT_BRAIN_MODEL=gpt-5.4-nano

# Fact-locked craft polish pass after atom generation (fail-closed).
# openai|auto = enable when OPENAI_API_KEY set; off = disable.
# Default follows PROMPT_EXPERIMENT_ATOM_CORE_LLM=b (variant B).
# ATOM_CRAFT_POLISH_PROVIDER=openai
# PROMPT_EXPERIMENT_ATOM_CORE_LLM=b

# At-scale resilience (P2.2) — all optional, sensible defaults.
# Max simultaneous OpenAI calls per process (default 4).
# OPENAI_MAX_CONCURRENCY=4
# Per-tenant daily LLM token budget (default 500000; 0 disables the cap).
# Enforced only when DATABASE_URL is set (usage lives in llm_usage_daily).
# BRAIN_TENANT_DAILY_TOKEN_CAP=500000
# Rate-limit counter store: production uses the DB automatically when
# DATABASE_URL is set; set db to force durable counters in dev too.
# RATE_LIMIT_STORE=db
# Topic history store: production uses the DB automatically; set db to use
# the topic_generations table in dev instead of data/runtime CSV.
# BRAIN_HISTORY_STORE=db

# Quality ops (P3.1) — all optional, all off/control by default.
# LLM-as-judge sampling rate over Idea Lab candidate runs (0..1; default 0 = off).
# Advisory only: judge scores land in traces and alerts, never in results.
# BRAIN_JUDGE_SAMPLE_RATE=0.1
# Prompt A/B for topic candidates: off (control), b (canary everyone on B),
# split (stable 50/50 by companyId). B runs stamp version "...+exp-b".
# PROMPT_EXPERIMENT_TOPIC_LLM_CANDIDATES=off

# Industry research expander (Perplexity → typed opportunities only; never TopicCandidates).
# INDUSTRY_RESEARCH_ENABLED=true
# INDUSTRY_RESEARCH_LIVE=false

# Short scene stills (Phase 4B): MM_IMAGE_RENDER=live enables Gemini → ImageKit.
# When MM_IMAGE_* are empty, live mode aliases GEMINI_API_KEY / GEMINI_IMAGE_MODEL
# and requires IMAGEKIT_PUBLIC_KEY + IMAGEKIT_PRIVATE_KEY + IMAGEKIT_URL_ENDPOINT.
# Default mode is dry_run until MM_IMAGE_RENDER=live.
# MM_IMAGE_RENDER=live
# MM_IMAGE_API_KEY=
# MM_IMAGE_PROVIDER=gemini
# MM_IMAGE_MODEL=
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=

# Project quality AI advisory audit (server-only; never commit real keys)
# PROJECT_AUDIT_PROVIDER=openai
# PROJECT_AUDIT_MODEL=gpt-5-mini

# Runtime (usually set by the host; documented for clarity)
NODE_ENV=development

# Canonical site origin (preferred server truth; required in production)
# Resolve order: SITE_ORIGIN → NEXT_PUBLIC_SITE_URL → NEXT_PUBLIC_APP_URL (legacy)
SITE_ORIGIN=http://localhost:3000
# Browser/SEO public origin — keep aligned with SITE_ORIGIN (rebuild after change)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Legacy alias only unless a genuinely different app host is required
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEO intelligence research (Phase 1B — server-only; never NEXT_PUBLIC_)
PERPLEXITY_API_KEY=
PERPLEXITY_SEO_MODEL=
PERPLEXITY_SEO_TIMEOUT_MS=
